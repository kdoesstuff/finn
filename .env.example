# Copy to .env for local runs. Never commit .env.
# In GitHub Actions these come from repository secrets; on Render/Vercel from their env settings.

# Models
GEMINI_API_KEY=
GROQ_API_KEY=
ZAI_API_KEY=
ZAI_BASE_URL=
OPENROUTER_API_KEY=

# Database (Supabase, Mumbai region)
SUPABASE_URL=
SUPABASE_ANON_KEY=          # safe in the browser only because every table has row-level security
SUPABASE_SERVICE_ROLE_KEY=  # server and pipeline only; never in the frontend

# Monitoring
SENTRY_DSN_API=
SENTRY_DSN_WEB=
