# FINN settings. Copy this file to `.env` in the same folder and fill in the values.
#   .env is git-ignored and must never be committed (GitHub push protection will also block it).
#   Check everything works:     python pipeline/scripts/check_setup.py
#   Copy to GitHub secrets:      gh secret set -f .env
# Format: NAME=value, no quotes, no spaces around "=".

# --- Models -------------------------------------------------------------------
# Google AI Studio (aistudio.google.com) -> Get API key. Free tier, no card.
GEMINI_API_KEY=
# Pin exact versions (never "-latest" aliases, which change underneath you).
# `python pipeline/scripts/check_setup.py --models` lists what your key offers.
# Free-tier daily limits drive these choices (Nov 2026): Flash-Lite 500/day, 3.8 Flash 20/day,
# Gemma 4 14,400/day, Embedding 2 1,000/day.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUALITY_MODEL=gemini-3.8-flash
GEMINI_VOLUME_MODEL=gemma-4-31b-it
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# Groq (console.groq.com) -> API Keys. Free tier, no card.
GROQ_API_KEY=
# gpt-oss-120b and -20b share the same free quota (30/min, 1,000/day), so the larger one is the default.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Screens untrusted filing text for prompt injection before it reaches a model (14,400/day).
GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# GLM through an OpenAI-compatible gateway. Here: Hyde (inference.hyde.tech -> API keys).
# Base URL: from the gateway's Guides page; usually ends in /v1.
# Model: exactly as the key's model list shows it.
GLM_API_KEY=
GLM_BASE_URL=https://inference.hyde.tech/v1
GLM_MODEL=hyde/glm-5.3-flash

# OpenRouter (openrouter.ai) -> Keys. Fallback only; cap the key's credit at $0 so only free models run.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Database: Supabase (supabase.com), project region Mumbai (ap-south-1) -----
# Use the new keys (legacy anon/service_role keys retire in 2027).
# URL: https://<project-id>.supabase.co (also under "Connect"). Keys: Project Settings -> API Keys.
SUPABASE_URL=
# sb_publishable_... : may be used in the browser, because every table has row-level security
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... : pipeline and API only, never the frontend
SUPABASE_SECRET_KEY=

# --- Monitoring: Sentry (sentry.io), two projects: Python and React ------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=
