# FINN settings. Copy this file to `.env` in the same folder and fill in the values.
#   .env is git-ignored and must never be committed (GitHub push protection will also block it).
#   Check everything works:     python pipeline/scripts/check_setup.py
#   Copy to GitHub secrets:      gh secret set -f .env
# Format: NAME=value, no quotes, no spaces around "=".

# --- Models -------------------------------------------------------------------
# Google AI Studio (aistudio.google.com) -> Get API key. Free tier, no card.
GEMINI_API_KEY=
# Optional; check_setup.py lists the Flash models your key can use if this one is missing.
GEMINI_MODEL=gemini-2.5-flash

# Groq (console.groq.com) -> API Keys. Free tier, no card.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Z.AI / GLM (z.ai or your existing access). OpenAI-compatible endpoint.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.5-flash

# OpenRouter (openrouter.ai) -> Keys. Fallback only.
OPENROUTER_API_KEY=

# --- Database: Supabase (supabase.com), project region Mumbai (ap-south-1) -----
# Project Settings -> API: Project URL, anon public key, service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Monitoring: Sentry (sentry.io), two projects: Python and React ------------
SENTRY_DSN_API=
SENTRY_DSN_WEB=
