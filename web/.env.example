# FINN web app settings, read at build time (Vite puts VITE_* values into the public bundle, so
# none of these is a secret). Locally: copy to web/.env.local. On Vercel: Settings > Environment
# Variables, one set per project (see docs/notes/B6.md).

# Required. The API's origin, https, no path. It must be listed in connect-src in web/vercel.json,
# or the build stops (browsers would block every call). Local API: http://localhost:8000
VITE_API_URL=

# "true" only on the full `finn` deployment; "false" or empty on `finn-core`.
VITE_NETWORK_ENABLED=

# Optional. Sentry DSN for the finn-web project. Empty: no error reporting, and Sentry is never loaded.
VITE_SENTRY_DSN=
